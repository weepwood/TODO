{
  "identifier": "default",
  "description": "Main window and local notification access",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "allow-native-take-quick-capture",
    "allow-native-shortcut-status",
    "allow-native-open-capture",
    "allow-native-list-backups",
    "allow-native-read-backup",
    "allow-native-create-backup",
    "allow-native-load",
    "allow-native-save",
    "allow-native-load-store",
    "allow-native-write-store",
    "allow-native-activate",
    "allow-native-search",
    "allow-native-notify",
    "allow-native-exit",
    "allow-native-test-notification"
  ]
}
