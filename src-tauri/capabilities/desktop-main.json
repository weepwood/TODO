{
  "identifier": "desktop-main",
  "description": "Desktop-only main window commands",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-native-take-quick-capture",
    "allow-native-shortcut-status",
    "allow-native-open-capture",
    "allow-native-exit",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "allow-native-direct-pending",
    "allow-native-direct-ack",
    "allow-native-direct-cancel-pending",
    "allow-native-cli-binding",
    "allow-native-activitywatch-status",
    "allow-native-activitywatch-report",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart"
  ]
}
