{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TODO",
  "version": "1.2.0-alpha.1",
  "identifier": "com.weepwood.todo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TODO",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "label": "main"
      },
      {
        "label": "capture",
        "title": "TODO \u00b7 \u5feb\u901f\u5f55\u5165",
        "url": "capture.html",
        "width": 520,
        "height": 315,
        "minWidth": 420,
        "minHeight": 290,
        "resizable": false,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "incognito": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://weepwood.github.io ipc: http://ipc.localhost https://xepkhnatnpvopnlqnrrz.supabase.co wss://xepkhnatnpvopnlqnrrz.supabase.co; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
